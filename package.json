{
  "name": "neon-strip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "shot": "node scripts/shot.mjs",
    "shots": "lockf -t 2400 .verify.lock node scripts/shots.mjs",
    "locate": "node scripts/locate.mjs",
    "walkthrough": "lockf -t 2400 .verify.lock node scripts/walkthrough.mjs",
    "multiplayer": "lockf -t 2400 .verify.lock node scripts/multiplayer.mjs",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "mode-toggle": "node scripts/modeToggle.mjs",
    "shared-craps": "node scripts/sharedCraps.mjs",
    "shared-blackjack": "node scripts/sharedBlackjack.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.0",
    "@react-three/rapier": "^2.2.0",
    "@supabase/supabase-js": "^2.112.4",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "playwright-core": "^1.62.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
